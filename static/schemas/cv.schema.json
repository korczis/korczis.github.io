{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://korczis.github.io/schemas/cv.schema.json",
  "title": "data/cv.toml",
  "description": "Work history, education, spoken languages, profile links and availability for hire: facts no repository holds, from the owner (ADR 0004, ADR 0007).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "roles",
    "education",
    "languages"
  ],
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}(-(0[1-9]|1[0-2]))?$"
    },
    "url": {
      "type": "string",
      "pattern": "^https://"
    },
    "text": {
      "type": "string",
      "minLength": 1
    }
  },
  "properties": {
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "organisation",
          "start"
        ],
        "properties": {
          "title": {
            "$ref": "#/$defs/text"
          },
          "title_cs": {
            "$ref": "#/$defs/text"
          },
          "organisation": {
            "$ref": "#/$defs/text"
          },
          "url": {
            "$ref": "#/$defs/url"
          },
          "start": {
            "$ref": "#/$defs/date"
          },
          "end": {
            "$ref": "#/$defs/date"
          },
          "summary": {
            "$ref": "#/$defs/text"
          },
          "summary_cs": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "education": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "institution",
          "degree"
        ],
        "properties": {
          "institution": {
            "$ref": "#/$defs/text"
          },
          "url": {
            "$ref": "#/$defs/url"
          },
          "degree": {
            "$ref": "#/$defs/text"
          },
          "degree_cs": {
            "$ref": "#/$defs/text"
          },
          "start": {
            "$ref": "#/$defs/date"
          },
          "end": {
            "$ref": "#/$defs/date"
          }
        }
      }
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "level"
        ],
        "properties": {
          "name": {
            "$ref": "#/$defs/text"
          },
          "name_cs": {
            "$ref": "#/$defs/text"
          },
          "level": {
            "enum": [
              "native",
              "fluent",
              "professional",
              "basic"
            ]
          }
        }
      }
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "description": "Profiles the owner keeps elsewhere; each becomes a sameAs of the JSON-LD Person.",
      "properties": {
        "linkedin": {
          "$ref": "#/$defs/url"
        }
      }
    },
    "hire": {
      "type": "object",
      "additionalProperties": false,
      "description": "Availability for hire, rendered on /hire/, in llms.txt and as the JSON-LD Person's jobTitle and makesOffer. Absent or available = false: nothing is shown.",
      "required": [
        "available",
        "headline",
        "roles",
        "engagement",
        "workplace",
        "regions"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "since": {
          "$ref": "#/$defs/date"
        },
        "headline": {
          "$ref": "#/$defs/text"
        },
        "headline_cs": {
          "$ref": "#/$defs/text"
        },
        "roles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "roles_cs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "engagement": {
          "type": "array",
          "items": {
            "enum": [
              "full-time",
              "contract",
              "fractional"
            ]
          }
        },
        "workplace": {
          "enum": [
            "remote",
            "hybrid",
            "on-site"
          ]
        },
        "regions": {
          "$ref": "#/$defs/text"
        },
        "regions_cs": {
          "$ref": "#/$defs/text"
        },
        "rate_from": {
          "type": "integer"
        },
        "rate_currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "rate_unit": {
          "enum": [
            "hour",
            "day"
          ]
        }
      }
    }
  }
}
