{
  "name": "korczis.github.io",
  "version": "1.0.0",
  "private": true,
  "description": "Tomas Korcak: personal hub. Projects, live sites and the stack behind them.",
  "license": "MIT",
  "author": "Tomas Korcak",
  "homepage": "https://korczis.github.io/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/korczis/korczis.github.io.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "vendor": "node scripts/vendor.mjs",
    "css": "tailwindcss --input styles/app.css --output static/css/app.css --minify",
    "assets": "npm run --silent vendor && npm run --silent css",
    "data": "node scripts/fetch-github.mjs",
    "llms": "node scripts/build-llms.mjs",
    "build": "npm run --silent assets && zola build",
    "check": "node scripts/gates.mjs run --ci",
    "dev": "node scripts/dev.mjs",
    "test:audit": "node scripts/audit-ui.mjs",
    "verify": "scripts/verify-all.sh",
    "gates": "node scripts/gates.mjs list",
    "og": "node scripts/build-og.mjs",
    "seo": "node scripts/check-seo.mjs",
    "categories": "node scripts/build-categories.mjs",
    "index": "node scripts/fetch-index.mjs",
    "site": "node scripts/build-site-json.mjs",
    "glossary": "node scripts/build-glossary.mjs",
    "refresh": "npm run --silent data && npm run --silent index && npm run --silent recent && npm run --silent derive",
    "derive": "node scripts/build-i18n.mjs && node scripts/fetch-index.mjs --derive && node scripts/fetch-recent.mjs --derive && node scripts/build-categories.mjs && node scripts/build-work.mjs && node scripts/build-glossary.mjs && node scripts/build-llms.mjs && node scripts/build-og.mjs && node scripts/build-site-json.mjs && node scripts/build-interfaces.mjs",
    "recent": "node scripts/fetch-recent.mjs",
    "i18n": "node scripts/build-i18n.mjs",
    "interfaces": "node scripts/build-interfaces.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@tailwindcss/cli": "4.3.5",
    "acorn": "8.19.0",
    "alpinejs": "3.17.5",
    "axe-core": "4.14.0",
    "d3": "7.9.2",
    "echarts": "6.1.0",
    "esbuild": "0.28.2",
    "flowbite": "4.0.2",
    "flowbite-typography": "1.0.5",
    "p5": "2.3.4",
    "playwright-core": "1.63.0",
    "smol-toml": "1.9.1",
    "tailwindcss": "4.3.5"
  }
}
