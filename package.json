{
  "name": "korczis.github.io",
  "version": "1.0.0",
  "private": true,
  "description": "Tomas Korcak: personal hub. Projects, live sites and the stack behind them.",
  "license": "MIT",
  "author": "Tomas Korcak",
  "homepage": "https://korczis.github.io/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/korczis/korczis.github.io.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "vendor": "node scripts/vendor.mjs",
    "css": "tailwindcss --input styles/app.css --output static/css/app.css --minify",
    "assets": "npm run --silent vendor && npm run --silent css",
    "data": "node scripts/fetch-github.mjs",
    "llms": "node scripts/build-llms.mjs",
    "build": "npm run --silent assets && zola build",
    "check": "node scripts/check-data.mjs && node scripts/build-categories.mjs --check && node scripts/build-llms.mjs --check && node scripts/build-og.mjs --check && node scripts/check-viz-layer.mjs && npm run --silent build && node scripts/check-seo.mjs",
    "dev": "npm run --silent assets && zola serve",
    "test:audit": "node scripts/audit-ui.mjs",
    "verify": "scripts/verify-all.sh",
    "og": "node scripts/build-og.mjs",
    "seo": "node scripts/check-seo.mjs",
    "categories": "node scripts/build-categories.mjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.5",
    "alpinejs": "3.17.5",
    "axe-core": "4.14.0",
    "chart.js": "4.5.1",
    "cytoscape": "3.34.4",
    "echarts": "6.1.0",
    "flowbite": "4.0.2",
    "p5": "2.3.4",
    "playwright-core": "1.63.0",
    "smol-toml": "1.9.0",
    "tailwindcss": "4.3.5"
  }
}
