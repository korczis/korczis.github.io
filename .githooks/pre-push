#!/usr/bin/env bash
# Majordomus supervision is mandatory here: a push must satisfy the active task's finish contract.
# A push to master is a production deploy, so it must also pass every gate CI runs before the
# browser audit (npm run verify -- --fast); a failing gate refuses the push locally instead of
# turning the deploy red.
set -euo pipefail

refs=""
[ -t 0 ] || refs=$(cat || true)

if ! command -v majordomus >/dev/null 2>&1; then
  echo "pre-push: majordomus is required (https://majordomus.dev)" >&2
  exit 1
fi
majordomus finish --check </dev/null || exit $?

while read -r _localref localsha remoteref _remotesha; do
  [ "$remoteref" = "refs/heads/master" ] || continue
  [ "$localsha" = "0000000000000000000000000000000000000000" ] && continue
  if [ "$(git rev-parse HEAD)" != "$localsha" ]; then
    echo "pre-push: pushing $localsha to master from a checkout at $(git rev-parse --short HEAD); check out what you deploy" >&2
    exit 1
  fi
  echo "pre-push: master is a deploy; running npm run verify -- --fast" >&2
  npm run --silent verify -- --fast </dev/null || { echo "pre-push: a gate failed; nothing was pushed" >&2; exit 1; }
done <<REFS
$refs
REFS
