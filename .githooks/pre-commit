#!/usr/bin/env bash
# Majordomus supervision is mandatory here: a commit requires a healthy, wired .ai/ layer.
set -euo pipefail
if ! command -v majordomus >/dev/null 2>&1; then
  echo "pre-commit: majordomus is required (https://majordomus.dev)" >&2
  exit 1
fi
MAJORDOMUS_DOCTOR_CONTEXT=commit majordomus doctor || exit $?
